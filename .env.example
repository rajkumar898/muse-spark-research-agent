# Copy this file to .env and fill in your key. Never commit .env.
# Key from the Meta Model API dashboard (dev.meta.ai) -> API keys
MODEL_API_KEY=your_key_here
MUSE_MODEL=muse-spark-1.3
MUSE_BASE_URL=https://api.meta.ai/v1
# minimal | low | medium | high | xhigh | max  (reasoning tokens are billed as output)
MUSE_REASONING_EFFORT=low
# 1 = always use the scripted MockMetaClient (no API calls to Meta)
MINI_MUSE_MOCK=0
# Optional: higher rate limits for paper search
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
